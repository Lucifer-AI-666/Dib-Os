# Divine Nexus — variabili d'ambiente (copiare in .env.local e compilare)

# Chiave Groq per le risposte del modello delle identita' locali (chat + consulente del Nonno).
GROQ_API_KEY=

# Segreto del Nonno Saggio: firma le "benedizioni" con cui autorizza i comandi.
# Usare una stringa lunga e casuale. Se assente, in sviluppo viene usato un
# fallback insicuro — NON usarlo in produzione.
NONNO_SECRET=

# Token della API /api/v1, usata da fuori casa. Senza questo valore la API risponde 401.
DIB_API_TOKEN=

# Indirizzo pubblico dell'API, messo nell'app al momento della build.
# Esempio: https://dib.example.com
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_DIB_API_TOKEN=

# Pagamento dopo i 3 giorni. Senza STRIPE_PRICE_ID si usa 9,90 € (shared/price.ts).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:8081
